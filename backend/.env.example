# ── Database ─────────────────────────────────────────────────────────────────
# The control database. CONTROL_DATABASE_URL is its new name; DATABASE_URL
# still works for one release (set one of them).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/hirebuddha
# Tenant data plane (Phase 14 WS2): single = one database for everything (today);
# split = each tenant's own database from the tenant directory. Make the two
# dev tenants first: python -m scripts.dev_tenants
# TENANCY_MODE=single
# Tenant database port: 0 = DATABASE_URL's port; 6432 on Azure (PgBouncer).
# TENANT_DB_PORT=0

# ── Security ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
SECRET_KEY=dev_secret_key_change_in_production
# Encrypts every stored third-party credential. Required: the API refuses to
# start without a random value of at least 32 characters (AU-24). Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it later needs scripts/rotate_encryption_key.py (see its docstring).
ENCRYPTION_MASTER_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── API edge (port 8000 serves every endpoint) ────────────────────────────────
# Per-client-IP limit on REST routes (webhooks and internal events are exempt)
RATE_LIMIT=200/minute

# Shared secret for internal microservice events (POST /internal/event).
# Empty or a placeholder disables the endpoint (it answers 503). Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_TOKEN=

# Host and protocol telephony providers reach this API on — used to build the
# TwiML <Stream> / Tata wss_url media-stream URLs and Twilio callback URLs.
# Production: STREAMING_HOST=gateway.hirebuddha.com, STREAMING_PROTOCOL=wss
STREAMING_HOST=localhost:8000
STREAMING_PROTOCOL=ws

# ── Video Streaming (WebRTC) ──────────────────────────────────────────────────
VIDEO_STREAMING_ENABLED=true
STUN_SERVERS=stun:stun.l.google.com:19302
# TURN_SERVER_URL=turn:your-turn-server.com:3478
# TURN_USERNAME=your-username
# TURN_CREDENTIAL=your-credential

# ── Tracing ───────────────────────────────────────────────────────────────────
# Spans are exported only when a collector is named (IN-23); with none, nothing
# retries an absent :4317. With docker-compose.observability.yml running:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://dev.hirebuddha.com,https://app.hirebuddha.com,https://gateway.hirebuddha.com

# ── Sandbox ───────────────────────────────────────────────────────────────────
# Model-written code (sandbox_code, terminal, the browser, synthesized tools)
# runs in the company's container by default (TL-01). That needs Docker and the
# two images: backend/docker/sandbox/build.sh, backend/docker/egress-proxy/build.sh.
# A development machine without them opts out here; production never does.
# SANDBOX_CONTAINER_RUNTIME_ENABLED=false

# ── Phase 14: platform adapters (docs/phase14/02_tech_spec.md §16, §19) ───────
# local | azure | onprem — the default adapter of every capability below.
# PLATFORM_PROFILE=local
# Files: local_disk (backend/artifact, or STORAGE_LOCAL_ROOT) | azure_blob.
# STORAGE_BACKEND=
# Try the Blob adapter against Azurite (docker compose up -d azurite):
# STORAGE_BACKEND=azure_blob
# AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
# On Azure: AZURE_STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net/ (workload identity, no key)
# Runtime secret lookups: env | azure_keyvault (+ AZURE_KEYVAULT_URL).
# SECRETS_BACKEND=
# Entra tokens from the workload's identity (or `az login` here): azure_workload_identity | none.
# WORKLOAD_IDENTITY_BACKEND=
# PostgreSQL sign-in: password (this file's DATABASE_URL) | entra_token (Azure Flexible Server).
# DB_AUTH=
# Claude: vertex | foundry | anthropic, when an integration's service_metadata names none.
# ANTHROPIC_PROVIDER=vertex
# FOUNDRY_ENDPOINT=https://<resource>.services.ai.azure.com/anthropic/
# Gemini/Vertex from outside Google Cloud: an external_account (federation) file.
# GOOGLE_WIF_CREDENTIAL_FILE=
