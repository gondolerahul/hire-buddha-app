# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hirebuddha

# ── Security ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
SECRET_KEY=dev_secret_key_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Unified Gateway (port 8001) ───────────────────────────────────────────────
GATEWAY_PORT=8001
BACKEND_URL=http://localhost:8000

# Shared secret for internal microservice events (POST /internal/event)
INTERNAL_TOKEN=change-me-in-production

# JWT secret for gateway-level auth (audio/video WebSocket handshake)
JWT_SECRET=change-me-in-production

# Streaming service public hostname (used to construct WS URLs for telephony)
STREAMING_HOST=localhost:8001
STREAMING_PROTOCOL=ws

# ── Video Streaming (WebRTC) ──────────────────────────────────────────────────
VIDEO_STREAMING_ENABLED=true
STUN_SERVERS=stun:stun.l.google.com:19302
# TURN_SERVER_URL=turn:your-turn-server.com:3478
# TURN_USERNAME=your-username
# TURN_CREDENTIAL=your-credential

# ── Event Bus ─────────────────────────────────────────────────────────────────
EVENT_BUS_TYPE=memory
EVENT_BUS_MAXSIZE=1000

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,https://dev.hirebuddha.com,https://gateway.hirebuddha.com
