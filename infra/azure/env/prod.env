# Azure production — the non-secret names and ids of the environment (setup guide §2).
# Same shape as dev.env (decision D49: production starts the size of dev). Fill in
# each <...> from the Bicep outputs when production is created; never a secret here.
SUB_ID=<production subscription id>
TENANT_ID=7cb9c9f3-27c0-412e-805c-fac9974e9cdc
LOCATION=centralindia
ENV=prod
PREFIX=hb
SUFFIX=<4 hex>

RG_CORE=rg-hb-prod-core
RG_DATA=rg-hb-prod-data
RG_AKS=rg-hb-prod-aks
RG_EDGE=rg-hb-prod-edge

VNET=vnet-hb-prod
AKS=aks-hb-prod
KV=kv-hb-prod-${SUFFIX}
ACR=acrhbprod${SUFFIX}
ST=sthbprod${SUFFIX}
PG_CONTROL=psql-hb-prod-control
REDIS=redis-hb-prod-${SUFFIX}
LAW=log-hb-prod
APPI=appi-hb-prod
# Before the switch-over (WS9) production answers on these names; today's
# app./api./gateway. hostnames move to it at cutover. To be confirmed.
DNS_ZONE=azprod.hirebuddha.com

# Entra groups (guide §5), production's own
ADMINS_GROUP_ID=<grp-hb-prod-admins object id>
DEVELOPERS_GROUP_ID=<grp-hb-prod-developers object id>
PGADMINS_GROUP_ID=<grp-hb-prod-pg-admins object id>

# Outputs of `az deployment sub create ... -p infra/azure/env/prod.bicepparam`
EGRESS_IP=<egressIp>               # send to partners that allow-list (Tata Tele, ...)
INGRESS_IP=<static ingress IP>
AKS_OIDC_ISSUER=<aksOidcIssuerUrl>
PG_CONTROL_FQDN=psql-hb-prod-control.postgres.database.azure.com
REDIS_HOST=<redisHostName>
CLIENT_ID_API=<identityClientIds.api>
CLIENT_ID_WORKER=<identityClientIds.worker>
CLIENT_ID_MIGRATOR=<identityClientIds.migrator>
CLIENT_ID_CONNSVC=<identityClientIds.connsvc>
CLIENT_ID_PROVISIONER=<identityClientIds.provisioner>
CLIENT_ID_APPCONTROLLER=<identityClientIds.appcontroller>
CLIENT_ID_CI=<identityClientIds.ci>
CLIENT_ID_AKS=<identityClientIds.aks>

PG_POOL_FQDN=psql-hb-prod-pool-01.postgres.database.azure.com
TENANT_KEYS_VAULT=kv-hb-prod-tk-${SUFFIX}
TENANT_KEYS_VAULT_URL=https://kv-hb-prod-tk-${SUFFIX}.vault.azure.net/
RG_TENANTS=rg-hb-prod-tenants
POOL_SERVER_NAME=pool-01
