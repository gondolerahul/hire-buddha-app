# The API, including /api/v1. Without it the app uses http://localhost:8000/api/v1
# and warns on the console. Downloads and previews use the same origin.
VITE_API_BASE_URL=http://localhost:8000/api/v1
# Where the dev server proxies /api, /reports and /artifact (vite.config.ts).
# Default: http://localhost:8000
# VITE_PROXY_TARGET=http://localhost:8000
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
VITE_MICROSOFT_CLIENT_ID=your_microsoft_client_id_here
