# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/
.env

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dist/
build/
.next/

# IDEs
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Project specific
logs/
# ...but never app source directories that happen to be named 'logs'
!mobile/android/app/src/**/logs/
!mobile/android/app/src/**/logs/**
*.log

# Backend runtime / generated directories
backend/uploads/
backend/artifact/
backend/assets/

# Claude
.claude/

# DB Backup artifacts (scripts are tracked, dumps/logs are not)
deploy/backup/dumps/
deploy/backup/logs/

# .env backups carry the same secrets as .env itself.
.env.bak*
.env.*.bak
*.env.bak*

# Release signing material — the keystore and its passwords must never be committed.
# Canonical copy lives at ~/.hirebuddha-secrets/ (docs/mobile-dialer-app/10 §4).
hirebuddha-signing-backup-*.tar.gz
*.jks
keystore.properties*

# Durable sandbox workspaces (TL-16): tenant files, never committed
backend/var/

# Local tenant key-encryption keys (src/common/platform/kek/local.py): never committed.
backend/.local-keys/
backend/.local-git/

# Per-environment deploy settings (names and ids, never secrets): tracked, unlike a Python env/.
!infra/azure/env/
!infra/k8s/env/

# The sandbox image's staged build context (deploy-azure.yml, local builds)
backend/docker/sandbox/stage/
